# Copy to `.env` and fill in. `.env` is gitignored; this file never carries values.
#
# The runtime blocked the canonical `.env.example` filename, so this is the same
# content under a different name.

# FIRMS Area API key. Request it with your email:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# The key arrives by email. It allows 5000 transactions per 10 minutes.
FIRMS_MAP_KEY=

# Where the ingest cache lives (one CSV per source/region/window).
FIRMS_CACHE_DIR=data/raw

# Backend
FIRETRACK_DATA_DIR=data
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
