# Copy to `.env` only if you need to override a default. `.env` is gitignored.
# No credential is needed: the FIRMS data comes from a public mirror (CC0).
#
# The runtime blocked the canonical `.env.example` filename, so this is the same
# content under a different name.

# FIRMS source: the Portolan GeoParquet mirror. Leave empty for the public mirror;
# set it only to point at a local copy with the same year=YYYY/detections.parquet layout.
FIRETRACK_FIRMS_BASE=

# Data folder (cache in data/cache/, sensor days in data/sensor_days.parquet, artifacts in data/processed/)
FIRETRACK_DATA_DIR=data

# Backend
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
